---
import "../styles/global.css";
import { site } from "../site";

type Props = {
  title?: string;
  description?: string;
  canonical?: string;
  type?: "website" | "article";
  publishDate?: Date;
  updatedDate?: Date;
  noindex?: boolean;
  wide?: boolean;
  full?: boolean;
};
const { title = site.title, description = site.description, canonical = Astro.url.pathname,
  type = "website", publishDate, updatedDate, noindex = false, wide = false, full = false } = Astro.props;
const pageTitle = title === site.title ? title : `${title} — ${site.title}`;
const canonicalUrl = new URL(canonical, site.url).toString();
const imageUrl = new URL("/frontispiece.png", site.url).toString();
const person = {
  "@type": "Person", "@id": `${site.url}/#person`, name: site.author, url: site.url,
  affiliation: { "@type": "Organization", name: site.affiliation },
  sameAs: Object.values(site.socials),
};
const articleSchemaType = canonical.startsWith("/reports/") ? "Report" : "BlogPosting";
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [person, {
    "@type": type === "article" ? articleSchemaType : canonical === "/" || canonical === "/cv/" ? "ProfilePage" : "WebPage",
    "@id": canonicalUrl, url: canonicalUrl, name: pageTitle, description,
    ...(type === "article" ? {
      headline: title, image: imageUrl, author: { "@id": person["@id"] },
      datePublished: publishDate?.toISOString(),
      dateModified: (updatedDate ?? publishDate)?.toISOString(),
    } : canonical === "/" || canonical === "/cv/" ? { mainEntity: { "@id": person["@id"] } } : {}),
  }],
};
const navigation = [{ href: "/#cv", label: "CV" }, { href: "/#skills", label: "Skills" }, { href: "/#software", label: "Software" }, { href: "/#publications", label: "Publications" }, { href: "/cv/", label: "PDF" }];
const isCurrent = (href: string) => !href.includes("#") && Astro.url.pathname.startsWith(href);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonicalUrl} />}
    <link rel="preload" href="/fonts/newsreader/newsreader-latin-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg" />
    <meta name="robots" content={noindex ? "noindex,follow" : "index,follow"} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    {!noindex && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="site-name" href="/">Oliver Hennhöfer</a>
      <nav aria-label="Main navigation">
        {navigation.map(({ href, label }) => <a href={href} aria-current={isCurrent(href) ? "page" : undefined}>{label}</a>)}
      </nav>
    </header>
    <main id="main" class:list={{ "reader-wide": wide, "page-full": full }} tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <span>Oliver Hennhöfer · Karlsruhe, Germany</span>
      <div><a href={`mailto:${site.email}`}>{site.email}</a><a href={site.impressumPath}>Impressum</a></div>
    </footer>
  </body>
</html>
