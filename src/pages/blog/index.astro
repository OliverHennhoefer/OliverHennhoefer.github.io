---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostList from "../../components/PostList.astro";
const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout title="Writing" description="Notes on machine learning, statistical inference, and uncertainty by Oliver Hennhöfer." canonical="/blog/">
  <section class="writing-intro">
    <p class="eyebrow">Notes &amp; explanations</p>
    <h1>Writing</h1>
    <p class="lede">Working through the ideas behind machine learning, statistical inference, and uncertainty.</p>
  </section>
  <section aria-label="Research notes">
    {posts.length > 0 ? <PostList posts={posts} /> : <p>New notes will appear here.</p>}
  </section>
</BaseLayout>
