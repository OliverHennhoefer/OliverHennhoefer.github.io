---
import BaseLayout from "../layouts/BaseLayout.astro";
import { countryPaths, graticule, mapHeight, mapWidth, visitedCountries, worldOutline } from "../utils/travel";
---
<BaseLayout title="Travel" description="A map of the places Oliver Hennhöfer has visited, in the Equal Earth projection." canonical="/travel/" wide>
  <header class="travel-intro">
    <p class="eyebrow">Away from the desk</p>
    <h1>Travel</h1>
    <p class="lede">Places I’ve been.</p>
  </header>
  <figure class="travel-map">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox={`0 0 ${mapWidth} ${mapHeight}`} role="img" aria-labelledby="map-title map-description">
      <title id="map-title">Places visited — Equal Earth world map</title>
      <desc id="map-description">Visited places are green; all others are grey. {visitedCountries.length > 0 ? `Visited: ${visitedCountries.join(", ")}.` : "No destinations have been added yet."}</desc>
      <path class="ocean" d={worldOutline} />
      <path class="graticule" d={graticule} />
      {countryPaths.map((country) => (
        <path class:list={["country", { visited: country.visited }]} d={country.path} data-country={country.name}>
          <title>{country.name}{country.visited ? " · Visited" : ""}</title>
        </path>
      ))}
      <path class="world-outline" d={worldOutline} />
    </svg>
    <figcaption>
      <div class="legend" aria-label="Map legend">
        <span><i class="legend-visited" aria-hidden="true"></i>Visited</span>
        <span><i class="legend-other" aria-hidden="true"></i>Not marked</span>
      </div>
    </figcaption>
  </figure>
  <section class="destinations" aria-labelledby="destinations-heading">
    <div class="section-heading">
      <h2 id="destinations-heading">Places visited</h2>
      {visitedCountries.length > 0 && <span class="place-count">{visitedCountries.length} {visitedCountries.length === 1 ? "place" : "places"}</span>}
    </div>
    {visitedCountries.length > 0 ? <ul>{visitedCountries.map((name) => <li>{name}</li>)}</ul> : <p class="empty-map">Destinations will appear here as I add them.</p>}
  </section>
  <p class="map-source">Map data: <a href="https://www.naturalearthdata.com/">Natural Earth</a>, via <a href="https://github.com/topojson/world-atlas">World Atlas</a>. UK countries: <a href="https://www.geoboundaries.org/">geoBoundaries</a> / Eurostat, <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>.</p>
</BaseLayout>
<style>
  .travel-intro { max-width: 46rem; margin-inline: auto; }
  .travel-map { margin: 2.5rem 0 3rem; }
  .travel-map svg { display: block; width: 100%; height: auto; }
  .ocean { fill: #f2f2ec; }
  .graticule { fill: none; stroke: #e0e2da; stroke-width: .6; }
  .country { fill: #d2d5cc; stroke: var(--paper); stroke-width: .55; stroke-linejoin: round; }
  .country:hover { fill: #aab3a7; }
  .country.visited { fill: #42765a; }
  .country.visited:hover { fill: #305d43; }
  .world-outline { fill: none; stroke: var(--line); stroke-width: .8; pointer-events: none; }
  figcaption { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .75rem; margin-top: 1.1rem; color: var(--muted); font-size: .78rem; }
  .legend { display: flex; flex-wrap: wrap; gap: 1.3rem; }
  .legend span { display: flex; align-items: center; gap: .5rem; }
  .legend i { width: .7rem; height: .7rem; display: inline-block; border-radius: 50%; }
  .legend-visited { background: #42765a; }
  .legend-other { background: #d2d5cc; }
  .destinations { max-width: 46rem; margin-inline: auto; border-top: 1px solid var(--line); padding-top: 1.5rem; }
  .destinations ul { list-style: none; padding: 0; columns: 3 10rem; column-gap: 2rem; font-size: .94rem; }
  .destinations li { break-inside: avoid; margin: 0 0 .5rem; }
  .place-count, .empty-map { color: var(--muted); font-size: .85rem; }
  .map-source { max-width: 46rem; margin: 2rem auto 0; color: var(--muted); font-size: .75rem; }
  @media (max-width: 600px) { .travel-map { margin-block: 2rem; } }
</style>
