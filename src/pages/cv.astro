---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectList from "../components/ProjectList.astro";
import PublicationList from "../components/PublicationList.astro";
import { projects } from "../data/projects";
import { publications } from "../data/publications";
import { site } from "../site";
---
<BaseLayout title="CV" description="Research experience, software, and publications by Oliver Hennhöfer." canonical="/cv/">
  <section aria-labelledby="cv-heading">
    <p class="eyebrow">Curriculum vitae</p>
    <h1 id="cv-heading">Oliver Hennhöfer</h1>
    <p class="lede">Research in machine learning and statistical methodology, with a focus on uncertainty, anomaly detection, and conformal inference.</p>
    <p class="cv-meta">{site.affiliation}<br /><a href={`mailto:${site.email}`}>{site.email}</a></p>
  </section>
  <section class="cv-section" aria-labelledby="experience-heading">
    <h2 id="experience-heading">Experience</h2>
    <article>
      <h3>Research Associate</h3>
      <p class="cv-meta">Intelligent Systems Research Group, Karlsruhe University of Applied Sciences<br />September 2023 — Present</p>
      <p>Research on uncertainty quantification for anomaly detection in data streams, with a focus on conformal inference and statistical error control.</p>
      <p>Within <a href="https://www.biflexindustrie.de/">BiFlex-Industrie</a>, I lead development of <a href="https://github.com/DataDrivenSustainabilitySolutions/off-key">off-key</a>, translating research into a practical platform for online anomaly detection. The initial application is monitoring bidirectional charging infrastructure, with the aim of supporting uses beyond the project.</p>
      <p>I set technical direction and development priorities, write most of the code, and supervise student contributors. Deployment is primarily handled by a student research assistant under my guidance and overall responsibility.</p>
    </article>
    <article>
      <h3>Software Engineer · Machine Learning</h3>
      <p class="cv-meta">INIT Group · May 2022 — September 2023</p>
      <p>Developed a cloud-based real-time application for public transport, with sole responsibility for the machine-learning pipeline used to predict passenger numbers.</p>
    </article>
    <article>
      <h3>Business Analyst · Project Coordination</h3>
      <p class="cv-meta">INIT Group · January 2021 — May 2022</p>
    </article>
    <article>
      <h3>Student Research Assistant · Statistics with R</h3>
      <p class="cv-meta">Karlsruhe University of Applied Sciences · October 2018 — January 2021</p>
    </article>
    <article>
      <h3>Master’s Thesis Research</h3>
      <p class="cv-meta">Disy Informationssysteme · March 2020 — September 2020</p>
      <p>Applied geostatistics and spatial econometrics to anomaly detection in environmental data. Deployed methods through an API and improved the project’s data preprocessing.</p>
    </article>
    <article>
      <h3>Working Student · Data Analysis &amp; Quality Assurance</h3>
      <p class="cv-meta">1&amp;1 IONOS · March 2018 — February 2020</p>
      <p>Quality assurance from March 2018 to June 2019; data analysis from June 2019 to February 2020.</p>
    </article>
    <article>
      <h3>Intern · Traffic Statistics</h3>
      <p class="cv-meta">Modus Consult Gericke · October 2015 — March 2016</p>
    </article>
  </section>
  <section class="cv-section" aria-labelledby="teaching-heading">
    <h2 id="teaching-heading">Teaching</h2>
    <article>
      <h3>Lecturer</h3>
      <p class="cv-meta">Karlsruhe University of Applied Sciences · September 2023 — Present</p>
      <ul>
        <li>Master’s courses: Unsupervised Learning; Data Science.</li>
        <li>Bachelor’s courses: Software Engineering; Environmental Monitoring.</li>
      </ul>
    </article>
  </section>
  <section class="cv-section" aria-labelledby="education-heading">
    <h2 id="education-heading">Education</h2>
    <article>
      <h3>M.Sc. Geomatics</h3>
      <p class="cv-meta">Karlsruhe University of Applied Sciences · 2018 — 2020</p>
      <p>Thesis: <em>Anomaly Detection in Precision Farming with R</em>.</p>
      <p>Coursework in object-oriented and web programming, software engineering, spatial databases, geostatistics, web services and geomonitoring, and open-source GIS.</p>
    </article>
    <article>
      <h3>B.Sc. Geoinformation Management</h3>
      <p class="cv-meta">Karlsruhe University of Applied Sciences · 2013 — 2017</p>
      <p>Thesis: <em lang="de">Statistik und Geoanalyse mit R im hochschulischen Kontext</em>.</p>
    </article>
  </section>
  <section class="cv-section" aria-labelledby="skills-heading">
    <h2 id="skills-heading">Technical background</h2>
    <ul>
      <li><strong>Statistics &amp; inference.</strong> Statistical modelling, econometrics, resampling, density estimation, and uncertainty quantification; conformal inference, sequential testing, and false discovery rate control with p-values and e-values.</li>
      <li><strong>Machine learning.</strong> Anomaly and change-point detection, online learning, model evaluation, and prediction pipelines; deep learning and NLP with language models. Tools include scikit-learn, PyOD, PyTorch, and Hugging Face Transformers.</li>
      <li><strong>Geospatial analysis.</strong> GIS, geostatistics, spatial econometrics, clustering, hotspot and spatial outlier detection, and environmental data analysis; ArcGIS and ArcPy.</li>
      <li><strong>Programming &amp; applications.</strong> Python, R, Java, SQL, and TypeScript/JavaScript; object-oriented design, REST APIs with FastAPI, and interactive interfaces with React and Shiny.</li>
      <li><strong>Data systems.</strong> Relational data modelling and PostgreSQL, asynchronous services, MQTT sensor streams, telemetry processing, and monitoring dashboards.</li>
      <li><strong>Scientific software &amp; delivery.</strong> Python and R package development, reproducible experiments, automated testing, documentation, and release workflows; Git, GitHub Actions, and Docker, with oversight of containerized deployment.</li>
    </ul>
  </section>
  <section class="cv-section" aria-labelledby="projects-heading">
    <h2 id="projects-heading">Research software</h2>
    <ProjectList projects={projects} />
  </section>
  <section class="cv-section" aria-labelledby="publications">
    <h2 id="publications">Publications</h2>
    <PublicationList publications={publications} />
  </section>
</BaseLayout>
