---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectList from "../components/ProjectList.astro";
import PublicationList from "../components/PublicationList.astro";
import { projects } from "../data/projects";
import { publications } from "../data/publications";
import { site } from "../site";
---
<BaseLayout title="CV" description="Research experience, software, and publications by Oliver Hennhöfer." canonical="/cv/">
  <section aria-labelledby="cv-heading">
    <p class="eyebrow">Curriculum vitae</p>
    <h1 id="cv-heading">Oliver Hennhöfer</h1>
    <p class="lede">Research in machine learning and statistical methodology, with a focus on uncertainty, anomaly detection, and conformal inference.</p>
    <p class="cv-meta">{site.affiliation}<br /><a href={`mailto:${site.email}`}>{site.email}</a></p>
  </section>
  <section class="cv-section" aria-labelledby="experience-heading">
    <h2 id="experience-heading">Experience</h2>
    <article>
      <h3>Research Staff</h3>
      <p class="cv-meta">Intelligent Systems Research Group, Hochschule Karlsruhe<br />2024 — Present</p>
      <ul>
        <li>Contribute to uncertainty-aware machine learning methodology for decision systems.</li>
        <li>Guide reproducible experimentation in anomaly detection and conformal inference workflows.</li>
      </ul>
    </article>
    <article>
      <h3>Research Assistant</h3>
      <p class="cv-meta">Institut für Angewandte Forschung, Hochschule Karlsruhe<br />2022 — 2024</p>
      <ul>
        <li>Supported applied projects in uncertainty quantification and statistical decision support.</li>
        <li>Developed and maintained reproducible code for early-stage research tooling.</li>
      </ul>
    </article>
  </section>
  <section class="cv-section" aria-labelledby="education-heading">
    <h2 id="education-heading">Education</h2>
    <article>
      <h3>Graduate Education</h3>
      <p class="cv-meta">Karlsruhe University of Applied Sciences · 2020 — Present</p>
      <p>Thesis and coursework in machine learning, statistics, and uncertainty-aware systems.</p>
    </article>
  </section>
  <section class="cv-section" aria-labelledby="skills-heading">
    <h2 id="skills-heading">Technical background</h2>
    <ul>
      <li>Python, JavaScript/TypeScript, Git, Docker, GitHub Actions</li>
      <li>Uncertainty estimation, anomaly detection, conformal inference</li>
      <li>Sequential methods, risk control, evaluation protocols</li>
      <li>Scientific software, reproducible experiments, documentation</li>
    </ul>
  </section>
  <section class="cv-section" aria-labelledby="projects-heading">
    <h2 id="projects-heading">Research software</h2>
    <ProjectList projects={projects} />
  </section>
  <section class="cv-section" aria-labelledby="publications">
    <h2 id="publications">Publications</h2>
    <PublicationList publications={publications} />
  </section>
</BaseLayout>
