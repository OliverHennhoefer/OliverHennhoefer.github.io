---
import { open } from "node:fs/promises";
import { resolve } from "node:path";
import { reports, type Report } from "../../data/reports";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate } from "../../utils/dates";

export async function getStaticPaths() {
  const published = reports.filter((report) => !report.draft);
  for (const report of published) {
    const handle = await open(resolve("public", `.${report.pdf}`), "r");
    try {
      const signature = Buffer.alloc(5);
      await handle.read(signature, 0, 5, 0);
      if (signature.toString() !== "%PDF-") throw new Error(`Report is not a PDF: ${report.pdf}`);
    } finally {
      await handle.close();
    }
  }
  return published.map((report) => ({ params: { id: report.id }, props: { report } }));
}
type Props = { report: Report };
const { report } = Astro.props;
---
<BaseLayout title={report.title} description={report.description} canonical={`/reports/${report.id}/`} type="article" publishDate={report.pubDate} wide>
  <article>
    <header class="report-header">
      <p class="eyebrow">{report.kind} · PDF</p>
      <h1>{report.title}</h1>
      <div class="post-meta">
        <time datetime={report.pubDate.toISOString()}>{formatDate(report.pubDate)}</time>
        {report.pages && <span>{report.pages} {report.pages === 1 ? "page" : "pages"}</span>}
      </div>
      <p class="report-summary">{report.description}</p>
    </header>
    <div class="pdf-toolbar" aria-label="PDF options">
      <a href={report.pdf} type="application/pdf">Open PDF</a>
      <a href={report.pdf} download>Download PDF</a>
      {report.code && <a href={report.code}>Code &amp; materials</a>}
    </div>
    <object class="pdf-reader" data={`${report.pdf}#view=FitH`} type="application/pdf" role="document" aria-label={`${report.title} — PDF document`}>
      <div class="pdf-fallback">
        <p>This browser cannot display the PDF here.</p>
        <a href={report.pdf}>Open the report as a PDF</a>
      </div>
    </object>
    <footer class="article-footer"><a href="/blog/">← All writing</a></footer>
  </article>
</BaseLayout>
<style>
  .report-header { max-width: 46rem; margin-inline: auto; }
  .report-header .post-meta { margin-bottom: 1.3rem; }
  .report-summary { font-size: 1rem; margin-bottom: 2rem; }
  .pdf-toolbar { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; padding: .7rem 0; font-size: .85rem; }
  .pdf-toolbar a { padding-block: .3rem; }
  .pdf-reader { display: block; width: 100%; height: 80vh; height: 80svh; min-height: 28rem; border: 1px solid var(--line); background: #fff; }
  .pdf-fallback { padding: 2rem; color: var(--ink); }
  @media print { .pdf-reader, .pdf-toolbar { display: none; } }
</style>
