---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectList from "../components/ProjectList.astro";
import PublicationList from "../components/PublicationList.astro";
import { projects } from "../data/projects";
import { publications } from "../data/publications";
import { site } from "../site";
---
<BaseLayout>
  <section class="intro" aria-labelledby="intro-heading">
    <p class="eyebrow">Machine learning &amp; statistical inference</p>
    <h1 id="intro-heading">Oliver Hennhöfer</h1>
    <p class="lede">I research uncertainty in machine learning and develop software that puts statistical methods into practice.</p>
    <p class="intro-context">I’m a research associate and lecturer at {site.affiliation}, working on conformal inference, anomaly detection, and sequential testing. My background spans geospatial analysis, machine learning in public transport, and research software development.</p>
    <ul class="profile-links" aria-label="Profile links">
      <li><a href={`mailto:${site.email}`}>Email</a></li>
      <li><a href={site.socials.scholar}>Google Scholar</a></li>
      <li><a href={site.socials.github}>GitHub</a></li>
      <li><a href={site.socials.linkedin}>LinkedIn</a></li>
      <li><a href={site.socials.x}>X</a></li>
    </ul>
  </section>
  <section class="home-section" aria-labelledby="work-heading">
    <div class="section-heading"><h2 id="work-heading">Research software</h2></div>
    <ProjectList projects={projects} />
  </section>
  <section class="home-section" aria-labelledby="papers-heading">
    <div class="section-heading"><h2 id="papers-heading">Publications</h2></div>
    <PublicationList publications={publications} />
  </section>
</BaseLayout>
