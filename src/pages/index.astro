---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../site";
import { faLinkedinIn } from "@fortawesome/free-brands-svg-icons";
import {
  siGithub,
  siGmail,
  siGooglescholar,
  siX,
} from "simple-icons";

type IconData = {
  path: string;
  viewBox: string;
  transform?: string;
};

const simpleIcon = (icon: { path: string }, viewBox = "0 0 24 24"): IconData => ({
  path: icon.path,
  viewBox,
});
const faIcon = (icon: { icon: [number, number, string[], string, string] }): IconData => ({
  path: icon.icon[4],
  viewBox: "0 0 24 24",
  transform: `scale(${24 / icon.icon[0]} ${24 / icon.icon[1]})`,
});
const iconSet = {
  github: simpleIcon(siGithub),
  linkedin: faIcon(faLinkedinIn),
  x: {
    ...simpleIcon(siX),
    transform: "translate(1.2 1.2) scale(0.9)",
  },
  dblp: simpleIcon(siGooglescholar),
  gmail: simpleIcon(siGmail),
};

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latestPosts = posts.slice(0, 3);
const formatDate = new Intl.DateTimeFormat("en", {
  day: "2-digit",
  month: "short",
  year: "numeric",
});
---

<BaseLayout>
  <section aria-labelledby="intro-heading">
    <p class="eyebrow">Research staff / Machine learning / Uncertainty</p>
    <h1 id="intro-heading">Oliver Hennh&ouml;fer</h1>
    <p class="lede">
      I focus on ML systems that make uncertainty explicit, especially through conformal inference.
    </p>
    <ul class="link-row" aria-label="Profile links">
      <li>
        <a class="icon-link" href={site.socials.github} aria-label="GitHub">
          <svg viewBox={iconSet.github.viewBox} aria-hidden="true">
            <path d={iconSet.github.path} />
          </svg>
        </a>
      </li>
      <li>
        <a class="icon-link" href={site.socials.linkedin} aria-label="LinkedIn">
          <svg viewBox={iconSet.linkedin.viewBox} aria-hidden="true">
            <path d={iconSet.linkedin.path} transform={iconSet.linkedin.transform} />
          </svg>
        </a>
      </li>
      <li>
        <a class="icon-link" href={site.socials.x} aria-label="X">
          <svg viewBox={iconSet.x.viewBox} aria-hidden="true">
            <path d={iconSet.x.path} transform={iconSet.x.transform} />
          </svg>
        </a>
      </li>
      <li>
        <a class="icon-link" href={site.socials.dblp} aria-label="Google Scholar">
          <svg viewBox={iconSet.dblp.viewBox} aria-hidden="true">
            <path d={iconSet.dblp.path} />
          </svg>
        </a>
      </li>
      <li>
        <a class="icon-link" href={`mailto:${site.email}`} aria-label="Email">
          <svg viewBox={iconSet.gmail.viewBox} aria-hidden="true">
            <path d={iconSet.gmail.path} />
          </svg>
        </a>
      </li>
    </ul>
  </section>

  <section aria-labelledby="latest-heading">
    <div class="split">
      <div>
        <h2 id="latest-heading">Blog</h2>
        <div class="post-list">
          {
            latestPosts.map((post) => (
              <article class="post-card">
                <time datetime={post.data.pubDate.toISOString()}>
                  {formatDate.format(post.data.pubDate)}
                </time>
                <div>
                  <h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
                  <p>{post.data.description}</p>
                  <ul class="tag-row" aria-label="Tags">
                    {post.data.tags.map((tag) => <li>{tag}</li>)}
                  </ul>
                </div>
              </article>
            ))
          }
        </div>
        <p><a href="/blog/">All posts</a></p>
      </div>
    </div>
  </section>

  <section aria-labelledby="work-heading">
    <div class="split">
      <div class="section-grid">
        <h2 id="work-heading">Research Focus</h2>
        <p>
          My work sits at the intersection of statistics and machine learning,
          especially when data are scarce, noisy, non-stationary, or arrive
          sequentially.
        </p>
        <ul>
          <li><strong>Uncertainty quantification.</strong> Conformal methods for interpretable prediction, scoring, and decision layers.</li>
          <li><strong>Conformal anomaly detection.</strong> Calibration layers that turn raw anomaly scores into statistically meaningful evidence.</li>
        </ul>
      </div>
    </div>
  </section>

  <section aria-labelledby="projects-heading">
    <div class="split">
      <div class="section-grid">
        <h2 id="projects-heading">Projects</h2>
        <article>
          <h3>nonconform</h3>
          <p>Python package for calibrated anomaly detection and decision-aware conformal inference methods.</p>
          <p class="project-links">
            <a href="https://github.com/OliverHennhoefer/nonconform">GitHub</a> /
            <a href="https://oliverhennhoefer.github.io/nonconform/">Docs</a> /
            <a href="https://pypi.org/project/nonconform/">PyPI</a> /
            <a href="https://arxiv.org/pdf/2605.13642">Paper</a>
          </p>
        </article>
        <article>
          <h3>online-fdr</h3>
          <p>Online false discovery rate and sequential decision-control methods for hypothesis testing streams.</p>
          <p class="project-links">
            <a href="https://github.com/OliverHennhoefer/online-fdr">GitHub</a> /
            <a href="https://oliverhennhoefer.github.io/online-fdr/">Docs</a>
          </p>
        </article>
        <article>
          <h3>aberrant</h3>
          <p>Anomaly detection experiments and streaming workflows for reproducible baseline comparisons.</p>
          <p class="project-links">
            <a href="https://github.com/OliverHennhoefer/aberrant">GitHub</a> /
            <a href="https://oliverhennhoefer.github.io/aberrant/">Docs</a>
          </p>
        </article>
      </div>
    </div>
  </section>

  <section aria-labelledby="publications-heading">
    <div class="split">
      <div>
        <h2 id="publications-heading">Publications</h2>
        <ol class="publication-list">
          <li>
            <a href="https://scholar.google.com/citations?view_op=view_citation&hl=de&user=Q6W4KREAAAAJ&citation_for_view=Q6W4KREAAAAJ:d1gkVwhDpl0C">
              <strong>Leave-One-Out-, Bootstrap- and Cross-Conformal Anomaly Detectors</strong>
            </a><br />
            <span class="publication-meta">
              O Hennhöfer, C Preisach, <em>IEEE International Conference on Knowledge Graph (ICKG) 15 (1), 110 - 119</em> (2024).
            </span>
          </li>
          <li>
            <a href="https://scholar.google.com/citations?view_op=view_citation&hl=de&user=Q6W4KREAAAAJ&citation_for_view=Q6W4KREAAAAJ:qjMakFHDy7sC">
              <strong>Between Resolution Collapse and Variance Inflation: Weighted Conformal Anomaly Detection in Low-Data Regimes</strong>
            </a><br />
            <span class="publication-meta">
              O Hennhöfer, C Preisach, <em>arXiv preprint arXiv:2603.23205</em> (2026).
            </span>
          </li>
          <li>
            <a href="https://scholar.google.com/citations?view_op=view_citation&hl=de&user=Q6W4KREAAAAJ&citation_for_view=Q6W4KREAAAAJ:2osOgNQ5qMEC">
              <strong>Interdisciplinary Harmonies: A Story-Driven Course on AI and Music to Increase Interest in Computer Science</strong>
            </a><br />
            <span class="publication-meta">
              K Marquardt, Q Shang, O Hennhöfer, L Happe, <em>Proceedings of the 6th European Conference on Software Engineering Education</em> (2025).
            </span>
          </li>
          <li>
            <a href="https://scholar.google.com/citations?view_op=view_citation&hl=de&user=Q6W4KREAAAAJ&citation_for_view=Q6W4KREAAAAJ:UeHWp8X0CEIC">
              <strong>Conformal Anomaly Detection in Python: Moving Beyond Heuristic Thresholds with 'nonconform'</strong>
            </a><br />
            <span class="publication-meta">
              O Hennhöfer, M Kirsch, C Preisach, <em>arXiv preprint arXiv:2605.13642</em> (2026).
            </span>
          </li>
          <li>
            <a href="https://scholar.google.com/citations?view_op=view_citation&hl=de&user=Q6W4KREAAAAJ&citation_for_view=Q6W4KREAAAAJ:u-x6o8ySG0sC">
              <strong>Anomaly Detection in Precision Agriculture with R</strong>
            </a><br />
            <span class="publication-meta">
              O Hennhöfer, Karlsruhe University of Applied Sciences, 2020.
            </span>
          </li>
          <li>
            <a href="https://scholar.google.com/citations?view_op=view_citation&hl=de&user=Q6W4KREAAAAJ&citation_for_view=Q6W4KREAAAAJ:9yKSN-GCB0IC">
              <strong>Multidimensional Exploratory Spatial Data Analysis</strong>
            </a><br />
            <span class="publication-meta">
              O Hennhöfer, J Bruns, P Ullrich, A Heiß, G Sharipov, D Paraforos, <em>GI_Forum 2021, 9, 136-151</em> (2021).
            </span>
          </li>
        </ol>
      </div>
    </div>
  </section>
</BaseLayout>
