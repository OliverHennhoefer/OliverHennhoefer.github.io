---
import BaseLayout from "../layouts/BaseLayout.astro";
import CareerTimeline from "../components/CareerTimeline.astro";
import Icon from "../components/Icon.astro";
import Stations from "../components/Stations.astro";
import { goals } from "../data/goals";
import { projects } from "../data/projects";
import { publications } from "../data/publications";
import { skills } from "../data/skills";
import { miniCountries, miniHeight, miniWidth } from "../utils/miniMap";
import { visitedCountries } from "../utils/travel";
import { site } from "../site";

const surname = "Hennhöfer";
const authorParts = (authors: string) => authors.split(",").map((name) => name.trim().split(" ").slice(1).join(" "));
const years = [...new Set(publications.map((publication) => publication.year))].sort((a, b) => b - a);
const firstAuthor = publications.filter((publication) => authorParts(publication.authors)[0] === surname).length;
const profiles = [
  { href: `mailto:${site.email}`, label: "Email", icon: "email" },
  { href: site.socials.linkedin, label: "LinkedIn", icon: "linkedin" },
  { href: site.socials.scholar, label: "Google Scholar", icon: "scholar" },
  { href: site.socials.github, label: "GitHub", icon: "github" },
  { href: site.socials.x, label: "X", icon: "x" },
] as const;
---
<BaseLayout title={site.homeTitle} canonical="/" full>
  <section class="index-row index-intro" aria-labelledby="intro-heading">
    <img class="portrait" src="/portrait-480.jpg" srcset="/portrait-480.jpg 480w, /portrait.jpg 1200w" sizes="(max-width: 760px) 6rem, 11rem" width="480" height="480" alt={`Portrait of ${site.author}`} fetchpriority="high" />
    <div>
      <div class="nameplate">
        <h1 id="intro-heading">Oliver Hennhöfer</h1>
        <p class="lede">Unsupervised Learning &amp; Uncertainty Quantification</p>
      </div>
      <p class="role-line">PhD candidate, Research Associate &amp; Lecturer · {site.affiliation}</p>
      <ul class="profiles" aria-label="Contact and profiles">
        {profiles.map(({ href, label, icon }) => <li><a href={href}><Icon name={icon} />{label}</a></li>)}
      </ul>
    </div>
  </section>

  {goals.length > 0 && (
    <section class="index-row" id="goals" aria-labelledby="goals-heading">
      <h2 id="goals-heading">Goals</h2>
      <ul class="goals">
        {goals.map((goal) => (
          <li class:list={{ done: goal.done }}>
            <span class="check" aria-hidden="true"></span>
            <span><span class="goal-title">{goal.title}</span>{goal.detail && <span class="goal-detail"> · {goal.detail}</span>}</span>
            <span class="goal-year tnum">{goal.done ? `Done${goal.year ? ` ${goal.year}` : ""}` : goal.year}</span>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="index-row" id="cv" aria-labelledby="cv-heading">
    <h2 id="cv-heading">CV</h2>
    <div>
      <CareerTimeline />
      <Stations />
      <a class="more-link" href="/cv/">Printable CV with skills and teaching details →</a>
    </div>
  </section>

  <section class="index-row" id="skills" aria-labelledby="skills-heading">
    <h2 id="skills-heading">Skills</h2>
    <ul class="skills-list">
      {skills.map((skill) => (
        <li>
          <h3>{skill.area}</h3>
          <ul class="tools" aria-label={skill.area}>
            {skill.methods.map((method) => <li class="method">{method}</li>)}
            {skill.tools.map((tool) => <li>{tool.icon && <Icon name={tool.icon} size={14} />}{tool.name}</li>)}
          </ul>
        </li>
      ))}
    </ul>
  </section>

  <section class="index-row" id="software" aria-labelledby="software-heading">
    <h2 id="software-heading">Software</h2>
    <ul class="software">
      {projects.map((project) => (
        <li>
          <h3><a href={project.links[0].href}>{project.name}</a></h3>
          <div>
            <p class="tool-role">{project.role}</p>
            <p>{project.summary}</p>
            <ul class="tool-links" aria-label={`${project.name} resources`}>
              {project.links.map(({ href, label }) => <li><a href={href} aria-label={`${project.name}: ${label}`}>{label}</a></li>)}
            </ul>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="index-row" id="publications" aria-labelledby="publications-heading">
    <h2 id="publications-heading">Publications</h2>
    <div>
      <p class="pub-summary">{publications.length} publications, {firstAuthor} as first author. <a href={site.socials.scholar}>Google Scholar ↗</a></p>
      {years.map((year) => (
        <div class="pub-year-group">
          <span class="pub-year tnum">{year}</span>
          <ol class="pubs">
            {publications.filter((publication) => publication.year === year).map((publication) => {
              const authors = authorParts(publication.authors);
              const shown = authors.length > 4 ? [authors[0], "et al."] : authors;
              return (
                <li>
                  <a class="pub-title" href={publication.url}>{publication.title}</a>
                  <p class="pub-meta">
                    <span class="venue">{publication.venueShort}</span>
                    <span class="kind">{publication.kind}</span>
                    {publication.talk && <span class="talk">{publication.talk}</span>}
                    <span class="authors">{shown.map((name, i) => <>{i > 0 && (name === "et al." ? " " : ", ")}{name === surname ? <span class="me">{name}</span> : name}</>)}</span>
                  </p>
                </li>
              );
            })}
          </ol>
        </div>
      ))}
    </div>
  </section>

  <section class="index-row" id="perspectives" aria-labelledby="perspectives-heading">
    <h2 id="perspectives-heading">Perspectives</h2>
    <figure class="mini-map">
      <svg viewBox={`0 0 ${miniWidth} ${miniHeight}`} role="img" aria-labelledby="map-title">
        <title id="map-title">World map with {visitedCountries.length} visited countries in black</title>
        {miniCountries.map((country) => (
          <path class:list={["country", { visited: country.visited }]} d={country.path} data-country={country.name}><title>{country.name}</title></path>
        ))}
      </svg>
      <figcaption><span class="count tnum">{visitedCountries.length} countries.</span> {visitedCountries.join(", ")}.</figcaption>
    </figure>
  </section>
</BaseLayout>
