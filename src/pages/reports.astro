---
import { open } from "node:fs/promises";
import { resolve } from "node:path";
import { reports as allReports } from "../data/reports";
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatDate } from "../utils/dates";

const reports = allReports.filter((report) => !report.draft)
  .sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf());

// Catch missing or incorrectly named uploads before publishing a broken PDF link.
for (const data of reports) {
  const handle = await open(resolve("public", `.${data.pdf}`), "r");
  try {
    const signature = Buffer.alloc(5);
    await handle.read(signature, 0, 5, 0);
    if (signature.toString() !== "%PDF-") throw new Error(`Report is not a PDF: ${data.pdf}`);
  } finally {
    await handle.close();
  }
}
---
<BaseLayout title="Technical reports" description="Short research reports, exploratory experiments, and negative results by Oliver Hennhöfer." canonical="/reports/">
  <section class="writing-intro" aria-labelledby="reports-heading">
    <p class="eyebrow">Experiments &amp; observations</p>
    <h1 id="reports-heading">Technical reports</h1>
    <p class="lede">Small experiments, unfinished lines of inquiry, and results that did not turn into a full paper.</p>
    <p class="intro-context">Short PDFs documenting a question, an approach, and what happened. Including negative results: what did not work, and what might be learned from it.</p>
  </section>
  <section class="report-list" aria-label="Research reports">
    {reports.length === 0 ? (
      <p class="reports-empty">No reports published yet.</p>
    ) : reports.map((data) => (
      <article class="report-entry" id={data.id}>
        <div class="report-meta">
          <span>{data.kind}</span>
          <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate)}</time>
        </div>
        <h2><a href={data.pdf} type="application/pdf">{data.title}</a></h2>
        <p>{data.description}</p>
        <div class="report-links">
          <a href={data.pdf} type="application/pdf" aria-label={`Read ${data.title} (PDF)`}>Read PDF{data.pages ? ` · ${data.pages} ${data.pages === 1 ? "page" : "pages"}` : ""}</a>
          {data.code && <a href={data.code}>Code &amp; materials</a>}
        </div>
      </article>
    ))}
  </section>
</BaseLayout>

<style>
  .report-entry, .reports-empty { border-top: 1px solid var(--line); padding-top: 1.5rem; }
  .report-entry + .report-entry { margin-top: 2rem; }
  .report-meta, .report-links { display: flex; flex-wrap: wrap; gap: .4rem 1.2rem; font-size: .8rem; }
  .report-meta { color: var(--muted); margin-bottom: .6rem; }
  .report-entry h2 { margin-bottom: .7rem; }
  .report-entry > p { font-size: .94rem; margin-bottom: .7rem; }
  .report-links a { padding-block: .35rem; }
  .reports-empty { color: var(--muted); }
</style>
