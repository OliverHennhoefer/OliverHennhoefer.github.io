---
// Small, deterministic line drawings that hint at what each package does.
import type { Glyph } from "../data/projects";
type Props = { kind: Glyph; width?: number };
const { kind, width = 300 } = Astro.props;
const h = 64;
let seed = { rug: 11, stream: 23, steps: 5, drift: 31, tokens: 3 }[kind];
const rnd = () => (seed = (seed * 1664525 + 1013904223) % 4294967296) / 4294967296;
const gauss = () => Math.sqrt(-2 * Math.log(1 - rnd())) * Math.cos(2 * Math.PI * rnd());
const r1 = (n: number) => Math.round(n * 10) / 10;
const base = h - 4;
const parts: string[] = [];

if (kind === "rug") {
  // Calibration scores, a conformal threshold, and one test point beyond it.
  parts.push(`<line x1="0" y1="${base}" x2="${width}" y2="${base}" class="faint"/>`);
  for (let i = 0; i < 52; i++) {
    const x = r1(8 + Math.abs(gauss()) * width * 0.22 + rnd() * width * 0.1);
    parts.push(`<line x1="${x}" y1="${base}" x2="${x}" y2="${r1(base - 10 - rnd() * 8)}" class="soft"/>`);
  }
  const t = r1(width * 0.7), p = r1(width * 0.86);
  parts.push(`<line x1="${t}" y1="6" x2="${t}" y2="${base}" class="dash"/>`);
  parts.push(`<line x1="${p}" y1="${base}" x2="${p}" y2="16" class="bold"/><circle cx="${p}" cy="14" r="3.2" class="dot"/>`);
}
if (kind === "stream" || kind === "drift") {
  // A sensor stream with one flagged spike, or with a level shift at a change point.
  const n = Math.round(width / 5), spike = Math.round(n * 0.68), change = Math.round(n * 0.62);
  let y = 36;
  const pts: string[] = [];
  for (let i = 0; i <= n; i++) {
    const level = kind === "drift" && i >= change ? 22 : 38;
    y += (level - y) * (kind === "drift" ? 0.35 : 0.25) + gauss() * 2.6;
    pts.push(`${i * 5},${r1(kind === "stream" && i === spike ? 6 : y)}`);
  }
  parts.push(`<polyline points="${pts.join(" ")}" class="line"/>`);
  if (kind === "stream") parts.push(`<circle cx="${spike * 5}" cy="6" r="5.5" class="ring"/>`);
  else parts.push(`<line x1="${change * 5}" y1="2" x2="${change * 5}" y2="${base}" class="dash"/>`);
}
if (kind === "steps") {
  // Hypotheses arrive in order; rejections fall under a boundary that rises after each discovery.
  let level = 18, d = `M0,${base - level}`;
  const n = Math.round((width - 6) / 10);
  for (let i = 0; i < n; i++) {
    const x = 6 + i * 10, reject = i % 9 === 6;
    const v = reject ? 3 + rnd() * (level - 7) : level + 5 + rnd() * (50 - level);
    parts.push(`<circle cx="${x}" cy="${r1(base - v)}" r="${reject ? 2.7 : 1.6}" class="${reject ? "dot" : "dot soft"}"/>`);
    level = reject ? Math.min(34, level + 12) : Math.max(9, level - 1.3);
    d += ` H${x + 5} V${r1(base - level)}`;
  }
  parts.push(`<line x1="0" y1="${base}" x2="${width}" y2="${base}" class="faint"/><path d="${d}" class="line thin"/>`);
}
if (kind === "tokens") {
  // A transcript as a row of words, one of them tagged.
  let x = 0, row = 0;
  while (row < 3) {
    const w = r1(10 + rnd() * 34), y = 12 + row * 17;
    if (x + w > width) { x = 0; row++; continue; }
    const tagged = row === 1 && x > width * 0.45 && !parts.some((p) => p.includes("tag"));
    parts.push(`<rect x="${x}" y="${y}" width="${w}" height="8" rx="2" class="${tagged ? "tag" : "word"}"/>`);
    if (tagged) parts.push(`<path d="M${r1(x + w / 2 - 4)},${y - 6} h8 l-4,4 z" class="dot tag-mark"/>`);
    x += w + 5;
  }
}
---
<svg class="glyph" viewBox={`0 0 ${width} ${h}`} preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false" set:html={parts.join("")} />
<style>
  .glyph { display: block; width: 100%; height: auto; color: var(--ink); overflow: visible; }
  .glyph :global(line), .glyph :global(polyline), .glyph :global(path) { stroke: currentColor; fill: none; }
  .glyph :global(.faint) { stroke-width: .6; opacity: .35; }
  .glyph :global(.soft) { stroke-width: 1.1; opacity: .5; }
  .glyph :global(.dash) { stroke-width: .8; stroke-dasharray: 3 3; }
  .glyph :global(.bold) { stroke-width: 2; }
  .glyph :global(.line) { stroke-width: 1.3; stroke-linejoin: round; }
  .glyph :global(.thin) { stroke-width: .9; }
  .glyph :global(.dot) { fill: currentColor; stroke: none; }
  .glyph :global(circle.soft) { fill: currentColor; stroke: none; opacity: .38; }
  .glyph :global(.ring) { fill: none; stroke: currentColor; stroke-width: .9; }
  .glyph :global(.word) { fill: currentColor; opacity: .16; stroke: none; }
  .glyph :global(.tag) { fill: currentColor; stroke: none; }
</style>
