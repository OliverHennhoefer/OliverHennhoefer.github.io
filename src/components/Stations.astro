---
import { laneKey, organisations, roleId, stations } from "../data/career";
import { orgLogos } from "../data/logos";
---
<ol class="stations">
  {stations.map((station) => {
    const logo = orgLogos[station.org];
    return (
    <li class="station">
      {"svg" in logo
        ? <svg class="mark" viewBox={logo.viewBox} style={[logo.fill && `--mark-bg:${logo.fill};--mark-pad:0px`, logo.pad && `--mark-pad:${logo.pad}`].filter(Boolean).join(";") || undefined} aria-hidden="true" set:html={logo.svg} />
        : <span class="mark dot" style={`--dot:${logo.color}`} aria-hidden="true"></span>}
      <div class="station-head">
        <span class="station-name">{organisations[station.org]}</span>
        <span class="station-period tnum">{station.period}</span>
      </div>
      <ul class="roles">
        {station.roles.map((role) => (
          <li class:list={["role", `lane-${laneKey[role.lane]}`]} id={roleId(station.org, role)}>
            <div class="role-head"><span class="role-title">{role.title}</span>{station.roles.length > 1 && <span class="role-period tnum">{role.period}</span>}</div>
            {role.points && <ul class="points">{role.points.map((point) => <li>{point}</li>)}</ul>}
          </li>
        ))}
      </ul>
    </li>
    );
  })}
</ol>
<style>
  /* --mark: organisation badge size; --axis: x of the connecting line (the badge centre). */
  .stations { --mark: 1.6rem; --gutter: 2.4rem; --axis: calc(var(--mark) / 2); list-style: none; padding: 0; margin: 0; }
  .station { position: relative; margin: 0; padding: 0 0 1.4rem var(--gutter); }
  .station::before { content: ""; position: absolute; left: calc(var(--axis) - .75px); top: var(--axis); bottom: -.35rem; border-left: 1.5px solid var(--line); }
  .station:last-child { padding-bottom: 0; }
  /* The oldest station still links its badge to its roles; the line stops at the last role's dot. */
  .station:last-child::before { bottom: 0; }
  .station:last-child .role:last-child::after { content: ""; position: absolute; left: calc(-1 * var(--gutter) + var(--axis) - 3px); top: calc(.78rem + 8px); bottom: 0; width: 6px; background: var(--paper); }
  /* Organisation logo in a round badge, all at one size; a plain brand-colour dot where no logo is used. */
  .mark { position: absolute; left: 0; top: 0; box-sizing: border-box; width: var(--mark); height: var(--mark); padding: var(--mark-pad, .24rem); border-radius: 50%; background: var(--mark-bg, var(--paper)); box-shadow: inset 0 0 0 1px var(--line), 0 0 0 3px var(--paper); overflow: hidden; }
  .mark[style*="--mark-bg"] { box-shadow: 0 0 0 3px var(--paper); }
  .mark.dot { padding: .34rem; background: var(--dot); background-clip: content-box; }
  .station-head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
  .station-name { font: 400 1.15rem/1.4 var(--serif); }
  .station-period, .role-period { font-size: .78rem; color: var(--muted); white-space: nowrap; }
  .roles { list-style: none; padding: 0; margin: .35rem 0 0; }
  .role { position: relative; margin: 0; padding: .3rem 0; scroll-margin-top: 7.5rem; }
  /* Briefly mark the role a timeline bar jumped to. */
  .role:target { animation: landed 2.2s ease-out; }
  @keyframes landed { from { background: color-mix(in srgb, var(--lane) 22%, transparent); } to { background: transparent; } }
  .role::before { content: ""; position: absolute; left: calc(-1 * var(--gutter) + var(--axis) - 4px); top: .78rem; width: 8px; height: 8px; border-radius: 50%; background: var(--lane); box-shadow: 0 0 0 2px var(--paper); }
  .role-head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
  .role-title { font-size: .92rem; font-weight: 500; }
  .points { list-style: none; padding: 0; margin: .2rem 0 0; max-width: 42rem; }
  .points li { position: relative; margin: .15rem 0 0; padding-left: .9rem; font-size: .86rem; line-height: 1.5; color: var(--muted); }
  .points li::before { content: ""; position: absolute; left: 0; top: .66em; width: .35rem; border-top: 1px solid var(--faint); }
  @media print { .mark, .role::before { print-color-adjust: exact; -webkit-print-color-adjust: exact; } }
</style>
