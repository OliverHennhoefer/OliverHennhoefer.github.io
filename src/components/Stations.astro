---
import { laneKey, organisations, roleId, stations } from "../data/career";
---
<ol class="stations">
  {stations.map((station) => (
    <li class="station">
      <div class="station-head">
        <span class="station-name">{organisations[station.org]}</span>
        <span class="station-period tnum">{station.period}</span>
      </div>
      <ul class="roles">
        {station.roles.map((role) => (
          <li class:list={["role", `lane-${laneKey[role.lane]}`]} id={roleId(station.org, role)}>
            <div class="role-head"><span class="role-title">{role.title}</span>{station.roles.length > 1 && <span class="role-period tnum">{role.period}</span>}</div>
            {role.points && <ul class="points">{role.points.map((point) => <li>{point}</li>)}</ul>}
          </li>
        ))}
      </ul>
    </li>
  ))}
</ol>
<style>
  .stations { list-style: none; padding: 0; margin: 0; }
  .station { position: relative; margin: 0; padding: 0 0 1.4rem 1.9rem; }
  .station::before { content: ""; position: absolute; left: .42rem; top: .9rem; bottom: -.35rem; border-left: 1.5px solid var(--line); }
  .station:last-child { padding-bottom: 0; }
  /* The oldest station still links its dot to its roles; the line stops at the last role's dot. */
  .station:last-child::before { bottom: 0; }
  .station:last-child .role:last-child::after { content: ""; position: absolute; left: calc(-1.9rem + .42rem - 2px); top: calc(.78rem + 8px); bottom: 0; width: 6px; background: var(--paper); }
  .station::after { content: ""; position: absolute; left: 0; top: .32rem; width: .95rem; height: .95rem; border-radius: 50%; background: var(--ink); box-shadow: 0 0 0 3px var(--paper); }
  .station-head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
  .station-name { font: 400 1.15rem/1.4 var(--serif); }
  .station-period, .role-period { font-size: .78rem; color: var(--muted); white-space: nowrap; }
  .roles { list-style: none; padding: 0; margin: .35rem 0 0; }
  .role { position: relative; margin: 0; padding: .3rem 0; scroll-margin-top: 7.5rem; }
  /* Briefly mark the role a timeline bar jumped to. */
  .role:target { animation: landed 2.2s ease-out; }
  @keyframes landed { from { background: color-mix(in srgb, var(--lane) 22%, transparent); } to { background: transparent; } }
  .role::before { content: ""; position: absolute; left: calc(-1.9rem + .42rem - 3.25px); top: .78rem; width: 8px; height: 8px; border-radius: 50%; background: var(--lane); box-shadow: 0 0 0 2px var(--paper); }
  .role-head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
  .role-title { font-size: .92rem; font-weight: 500; }
  .points { list-style: none; padding: 0; margin: .2rem 0 0; max-width: 42rem; }
  .points li { position: relative; margin: .15rem 0 0; padding-left: .9rem; font-size: .86rem; line-height: 1.5; color: var(--muted); }
  .points li::before { content: ""; position: absolute; left: 0; top: .66em; width: .35rem; border-top: 1px solid var(--faint); }
  @media print { .station::after, .role::before { print-color-adjust: exact; -webkit-print-color-adjust: exact; } }
</style>
