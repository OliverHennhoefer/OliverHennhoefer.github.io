---
import { icons, type IconName } from "../data/icons";
type Props = { name: IconName; size?: number };
const { name, size = 15 } = Astro.props;
---
<svg class="icon" viewBox="0 0 24 24" width={size} height={size} aria-hidden="true" focusable="false"><path fill="currentColor" fill-rule={name === "email" ? "evenodd" : undefined} d={icons[name]} /></svg>
