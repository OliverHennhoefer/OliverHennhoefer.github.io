---
import { icons, type IconName } from "../data/icons";
type Props = { name: IconName };
const { name } = Astro.props;
---
<svg class="icon" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" focusable="false"><path fill="currentColor" fill-rule={name === "email" ? "evenodd" : undefined} d={icons[name]} /></svg>
