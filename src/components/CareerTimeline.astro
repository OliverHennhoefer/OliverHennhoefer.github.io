---
import { laneKey, organisations, stations, type Lane } from "../data/career";

const now = new Date();
const today = now.getUTCFullYear() + now.getUTCMonth() / 12;
const roles = stations.flatMap((station) => station.roles.map((role) => ({ ...role, org: station.org })));
const start = Math.min(...roles.map((role) => role.start));
const end = Math.ceil(today + 0.25);
const pct = (year: number) => `${(((year - start) / (end - start)) * 100).toFixed(2)}%`;
const lanes: Lane[] = ["Education", "Industry", "Research & teaching"];
const ticks = Array.from({ length: Math.floor((end - start) / 2) + 1 }, (_, i) => Math.ceil(start / 2) * 2 + i * 2).filter((year) => year > start && year < end);
const summary = roles.slice().sort((a, b) => a.start - b.start).map((role) => `${role.period}: ${role.title}, ${organisations[role.org]}`).join("; ");
---
<figure class="timeline" aria-label={`Career timeline. ${summary}.`}>
  {lanes.map((lane) => (
    <div class:list={["lane", `lane-${laneKey[lane]}`]} aria-hidden="true">
      <span class="lane-label"><i></i>{lane}</span>
      <div class="track">
        {roles.filter((role) => role.lane === lane && !role.hideBar).map((role) => (
          <span
            class:list={["bar", { ongoing: role.end === undefined }]}
            style={`left:${pct(role.start)};width:calc(${pct(role.end ?? today)} - ${pct(role.start)} - 2px)`}
            title={`${role.title} · ${organisations[role.org]} · ${role.period}`}
          ></span>
        ))}
      </div>
    </div>
  ))}
  <div class="lane axis" aria-hidden="true">
    <span></span>
    <div class="ticks">
      {ticks.map((year, i) => <span class:list={{ minor: i % 2 === 1 }} style={`left:${pct(year)}`}>{year}</span>)}
    </div>
  </div>
</figure>
<style>
  .timeline { margin: 0 0 2rem; }
  .lane { display: grid; grid-template-columns: 9.2rem minmax(0, 1fr); align-items: center; height: 1.7rem; }
  .lane-label { display: flex; align-items: center; gap: .4rem; font-size: .72rem; color: var(--muted); }
  .lane-label i { width: .5rem; height: .5rem; border-radius: 50%; background: var(--lane); flex: none; }
  .track { position: relative; height: 100%; }
  .track::before { content: ""; position: absolute; inset: 50% 0 auto; border-top: 1px dotted var(--faint); }
  .bar { position: absolute; top: 50%; height: 10px; margin-top: -5px; border-radius: 3px; background: var(--lane); }
  .bar.ongoing::after { content: ""; position: absolute; right: -10px; top: 50%; width: 6px; height: 6px; margin-top: -3px; border-radius: 50%; background: var(--lane); animation: pulse 2.4s ease-in-out infinite; }
  @keyframes pulse { 50% { opacity: .2; } }
  .axis { height: 1.4rem; margin-top: .3rem; }
  .ticks { position: relative; height: 100%; border-top: 1px solid var(--line); }
  .ticks span { position: absolute; top: .3rem; transform: translateX(-50%); font-size: .68rem; color: var(--muted); font-variant-numeric: tabular-nums; }
  @media (max-width: 600px) { .lane { grid-template-columns: 5.6rem minmax(0, 1fr); } .lane-label { font-size: .66rem; } .ticks .minor { display: none; } }
  @media print { .timeline { display: none; } }
</style>
